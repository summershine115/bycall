# ============================================================
# Bycall 配置模板 —— 复制为 .env 并按需修改（.env 不进 git）
# 所有字段均可被同名环境变量覆盖，详见 src/bycall/config.py
# ============================================================

# ---- 通用 ----
# 运行环境：dev / prod
BYCALL_ENV=dev
BYCALL_DEBUG=true
# 日志级别：DEBUG / INFO / WARNING / ERROR
BYCALL_LOG_LEVEL=INFO
# Cookie 签名密钥；生产必须为随机值且至少 32 字符。
BYCALL_SESSION_SECRET=bycall-dev-change-me-in-prod
# DB 中模型/IM 密钥的加密根密钥；生产必须独立设置且至少 32 字符。
BYCALL_SECRET_ENCRYPTION_KEY=
# 仅生产首次初始化且 DB 尚无 admin 时使用；创建成功后从环境移除。
BYCALL_BOOTSTRAP_ADMIN_PASSWORD=

# ---- LLM（模型无关，M0 先支持 openai 兼容 + glm）----
# provider 取值：openai | glm
BYCALL_LLM_PROVIDER=openai
# OpenAI 兼容 base_url：可指向官方 / 代理 / 本地 vLLM
BYCALL_LLM_BASE_URL=https://api.openai.com/v1
# GLM 默认用智谱 BigModel OpenAI 兼容端点（切换 provider=glm 时建议改这里）
# BYCALL_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
BYCALL_LLM_API_KEY=sk-replace-me
BYCALL_LLM_MODEL=gpt-4o-mini
BYCALL_LLM_EMBED_MODEL=text-embedding-3-small
BYCALL_LLM_TIMEOUT=60

# ---- 向量库（M0 默认 zvec，接口预留 pgvector/qdrant 迁移）----
BYCALL_VECTOR_STORE_BACKEND=zvec
# zvec 数据目录（嵌入式库，数据落本地）
BYCALL_VECTOR_STORE_DATA_DIR=./data/zvec
# embedding 维度，需与 LLM_EMBED_MODEL 对齐（text-embedding-3-small=1536）
BYCALL_VECTOR_STORE_DIMENSION=1536
# 只读模式：多进程并发读时设 true（M0 单进程默认 false）
BYCALL_VECTOR_STORE_READ_ONLY=false

# ---- 文档解析引擎（可切换：builtin / markitdown / mineru）----
# 引擎层在按扩展名路由的解析器之上。非默认引擎不支持的类型自动退回 builtin。
# 注意：以下解析配置现已可在 admin 控制台「运行时设置」页编辑，优先级 DB > .env > 默认；
# 首次启动从 .env 回填默认值，之后以 DB 为准。.env 仅作首次部署 / 容器化引导用。
BYCALL_PARSE_ENGINE=builtin
# MarkItDown（本地库，pip install 'bycall[parse]' 装依赖）；启用第三方插件
BYCALL_PARSE_MARKITDOWN_ENABLE_PLUGINS=false
# MinerU 远程 API（两种部署，由 MODE 切换；协议不同，详见 mineru_client.py）
# 部署模式：selfhost（自建 mineru-api /tasks）/ cloud（mineru.net /api/v4）
BYCALL_PARSE_MINERU_MODE=selfhost
# 服务基地址：selfhost 自建根（如 http://127.0.0.1:8000，空→不可用）；
#             cloud 填 mineru.net 根（如 https://mineru.net，空→默认 mineru.net）
BYCALL_PARSE_MINERU_BASE_URL=
# 鉴权 token（Bearer）：selfhost 多数可留空；cloud（mineru.net）必填
BYCALL_PARSE_MINERU_API_TOKEN=
# ---- selfhost 专用（MinerU CLI --backend / --parse_method）----
BYCALL_PARSE_MINERU_BACKEND=hybrid-auto-engine
BYCALL_PARSE_MINERU_PARSE_METHOD=auto
# ---- cloud 专用（mineru.net 精准解析 model_version / is_ocr）----
# 模型版本：pipeline / vlm（推荐） / MinerU-HTML（HTML 专用）
BYCALL_PARSE_MINERU_MODEL_VERSION=vlm
# 是否强制 OCR（is_ocr）；默认 false 自动识别扫描件
BYCALL_PARSE_MINERU_IS_OCR=false
# ---- 共用 ----
# OCR 语言组：ch / en / korean / japan
BYCALL_PARSE_MINERU_LANG=ch
# 单任务最长等待秒（远程解析较慢）
BYCALL_PARSE_MINERU_TIMEOUT=600
BYCALL_PARSE_MINERU_POLL_INTERVAL=2

# ---- PostgreSQL（状态/记忆/元数据；M0 只起服务）----
BYCALL_POSTGRES_DSN=postgresql://bycall:bycall@localhost:5432/bycall
BYCALL_POSTGRES_POOL_SIZE=10

# ---- Redis（缓存/队列；M0 只起服务）----
BYCALL_REDIS_URL=redis://localhost:6379/0

# ---- 可观测性（M5 OpenTelemetry，默认关闭；启用后 trace 经 OTLP 发往自建 collector）----
# 启用全链路 trace + 结构化日志（correlation_id 贯穿）。默认 false：setup 完全 no-op。
BYCALL_OTEL_ENABLED=false
# OTLP endpoint（gRPC/HTTP，如 http://otel-collector:4317）。空 → 仅 console exporter（开发用）。
BYCALL_OTEL_OTLP_ENDPOINT=
BYCALL_OTEL_SERVICE_NAME=bycall
# head-based 采样率，1.0 = 全采样。
BYCALL_OTEL_SAMPLER_RATIO=1.0
# 结构化日志：true=JSON（生产），false=人类可读带 correlation_id（开发）。
BYCALL_OTEL_STRUCTURED_LOGS=false
